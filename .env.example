# Database URL (MongoDB Connection String)
DATABASE_URL=mongodb://localhost:27017/payload-template

# Payload Secret (Use a secure, long random string for production)
PAYLOAD_SECRET=your-payload-secret-here

# next-intl (no var needed; routing is code-based)
# Cloudflare R2 (leave empty in dev for local-disk uploads)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
# Resend (transactional emails)
RESEND_API_KEY=
# Payload server URL (used in OAuth + verification email)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000